# Copy this file to .env.local or .env, then replace the placeholders with values
# from Supabase Project Settings > Database > Connection string.

# Runtime Prisma Client connection.
# Use Supavisor Transaction Pooler for serverless/Next.js deployments.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI connection for migrations and introspection.
# Use a direct connection or the Supavisor Session Pooler on port 5432.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth settings used by server-side auth verification.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"

# Optional development-only header auth fallback:
# x-dev-auth-user-id
# x-dev-auth-email
# x-dev-auth-name

# Optional client-side development defaults for Sprint 1 FE integration.
NEXT_PUBLIC_DEV_AUTH_USER_ID="dev-user-1"
NEXT_PUBLIC_DEV_AUTH_EMAIL="dev@example.com"
NEXT_PUBLIC_DEV_AUTH_NAME="Ibu Rani"

# Optional LLM config for persisted child insights.
# Use an OpenAI-compatible chat completions endpoint that serves Qwen or another model.
# If these are left empty, insight generation falls back to the built-in rule-based generator.
INSIGHT_LLM_API_URL=""
INSIGHT_LLM_API_KEY=""
INSIGHT_LLM_MODEL=""

