generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FocusArea {
  COMMUNICATION
  MOTORIC
  BEHAVIOR
  ACADEMIC
}

enum ConsentScope {
  HEALTH_DATA
  AI_INSIGHT
  MEDIA_UPLOAD
  DOCUMENT_ANALYSIS
  LOCATION
}

enum InputType {
  TEXT
  PHOTO
  AUDIO
  DOCUMENT
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum RoadmapStatus {
  ACHIEVED
  IN_PROGRESS
  NEXT_TARGET
  NEEDS_ATTENTION
  PAUSED
}

enum InsightKind {
  WEEKLY
  ENTRY
  ROADMAP
  ASSISTANT
  DOCUMENT
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Guardian {
  id          String    @id @default(cuid())
  authUserId  String    @unique @map("auth_user_id")
  email       String    @unique
  displayName String?   @map("display_name")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  children               Child[]
  auditLogs              AuditLog[]
  assistantConversations AssistantConversation[]
  assistantResponseLogs  AssistantResponseLog[]
  assistantEvaluations   AssistantEvaluation[]

  @@map("guardians")
}

model Child {
  id                    String      @id @default(cuid())
  guardianId            String      @map("guardian_id")
  name                  String
  birthDate             DateTime    @map("birth_date")
  condition             String
  focusAreas            FocusArea[] @map("focus_areas")
  routine               String?
  supportNeed           String?     @map("support_need")
  onboardingCompletedAt DateTime?   @map("onboarding_completed_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at")

  guardian               Guardian                @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  consents               Consent[]
  progressEntries        ProgressEntry[]
  mediaAssets            MediaAsset[]
  roadmapItems           RoadmapItem[]
  insights               Insight[]
  auditLogs              AuditLog[]
  assistantConversations AssistantConversation[]
  contextSnapshots       ChildContextSnapshot[]
  assistantResponseLogs  AssistantResponseLog[]
  assistantEvaluations   AssistantEvaluation[]

  @@index([guardianId])
  @@index([deletedAt])
  @@map("children")
}

model Consent {
  id        String       @id @default(cuid())
  childId   String       @map("child_id")
  scope     ConsentScope
  granted   Boolean      @default(false)
  grantedAt DateTime?    @map("granted_at")
  revokedAt DateTime?    @map("revoked_at")
  source    String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, scope])
  @@index([childId, granted])
  @@map("consents")
}

model ProgressEntry {
  id         String    @id @default(cuid())
  childId    String    @map("child_id")
  area       FocusArea
  inputType  InputType @default(TEXT) @map("input_type")
  title      String?
  note       String?
  insight    String?
  observedAt DateTime  @default(now()) @map("observed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  child       Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  mediaAssets MediaAsset[]
  insights    Insight[]

  @@index([childId, observedAt])
  @@index([childId, area])
  @@index([childId, inputType])
  @@index([deletedAt])
  @@map("progress_entries")
}

model MediaAsset {
  id              String      @id @default(cuid())
  childId         String      @map("child_id")
  progressEntryId String?     @map("progress_entry_id")
  type            InputType
  storageBucket   String?     @map("storage_bucket")
  storageKey      String      @map("storage_key")
  url             String?
  mimeType        String?     @map("mime_type")
  sizeBytes       Int?        @map("size_bytes")
  status          MediaStatus @default(PENDING_UPLOAD)
  processingError String?     @map("processing_error")
  processedOutput Json?       @map("processed_output")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  child          Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  progressEntry  ProgressEntry?  @relation(fields: [progressEntryId], references: [id], onDelete: SetNull)
  processingJobs ProcessingJob[]

  @@index([childId, status])
  @@index([progressEntryId])
  @@map("media_assets")
}

model RoadmapItem {
  id              String        @id @default(cuid())
  childId         String        @map("child_id")
  area            FocusArea
  title           String
  detail          String?
  status          RoadmapStatus @default(NEXT_TARGET)
  evidence        Json?
  confidenceScore Float         @default(0) @map("confidence_score")
  sortOrder       Int           @default(0) @map("sort_order")
  achievedAt      DateTime?     @map("achieved_at")
  lastPersonalizedAt DateTime?  @map("last_personalized_at")
  personalizationSource String? @map("personalization_source")
  sourceInsightId  String?      @map("source_insight_id")
  personalizationReason String? @map("personalization_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, sortOrder])
  @@index([childId, status])
  @@map("roadmap_items")
}

model Insight {
  id              String      @id @default(cuid())
  childId         String      @map("child_id")
  progressEntryId String?     @map("progress_entry_id")
  kind            InsightKind @default(WEEKLY)
  summary         String
  alerts          Json?
  recommendations Json?
  confidenceScore Float       @default(0) @map("confidence_score")
  rangeStart      DateTime?   @map("range_start")
  rangeEnd        DateTime?   @map("range_end")
  generatedBy     String?     @map("generated_by")
  sourceDataHash  String?     @map("source_data_hash")
  status          String      @default("READY")
  version         Int         @default(1)
  modelName       String?     @map("model_name")
  promptVersion   String?     @map("prompt_version")
  rawInput        Json?       @map("raw_input")
  rawOutput       Json?       @map("raw_output")
  isActive        Boolean     @default(true) @map("is_active")
  staleAt         DateTime?   @map("stale_at")
  generatedAt     DateTime?   @map("generated_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  child         Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  progressEntry ProgressEntry? @relation(fields: [progressEntryId], references: [id], onDelete: SetNull)

  @@index([childId, kind, createdAt])
  @@index([childId, isActive, createdAt])
  @@index([childId, sourceDataHash])
  @@index([progressEntryId])
  @@map("insights")
}

model AuditLog {
  id         String   @id @default(cuid())
  guardianId String?  @map("guardian_id")
  childId    String?  @map("child_id")
  action     String
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  child    Child?    @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([guardianId, createdAt])
  @@index([childId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  category    String
  readTime    Int       @map("read_time")
  summary     String
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([category, published])
  @@map("articles")
}

model AssistantConversation {
  id         String   @id @default(cuid())
  guardianId String   @map("guardian_id")
  childId    String?  @map("child_id")
  title      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  guardian Guardian           @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  child    Child?             @relation(fields: [childId], references: [id], onDelete: SetNull)
  messages AssistantMessage[]
  responseLogs AssistantResponseLog[]

  @@index([guardianId, updatedAt])
  @@index([childId, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

model KnowledgeArticle {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  summary        String?
  body           String
  category       String
  sourceLabel    String?  @map("source_label")
  sourceUrl      String?  @map("source_url")
  evidenceLevel  String?  @map("evidence_level")
  language       String   @default("id-ID")
  ageMinMonths   Int?     @map("age_min_months")
  ageMaxMonths   Int?     @map("age_max_months")
  conditionTags  Json?    @map("condition_tags")
  focusAreaTags  Json?    @map("focus_area_tags")
  safetyTags     Json?    @map("safety_tags")
  reviewStatus   String   @default("approved") @map("review_status")
  approvedBy     String?  @map("approved_by")
  reviewedBy     String?  @map("reviewed_by")
  reviewNotes    String?  @map("review_notes")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  chunks KnowledgeChunk[]

  @@index([category, reviewStatus])
  @@index([publishedAt])
  @@map("knowledge_articles")
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  articleId      String   @map("article_id")
  chunkIndex     Int      @map("chunk_index")
  heading        String?
  chunkText      String   @map("chunk_text")
  keywords       Json?
  embedding      Json?
  tokenCount     Int?     @map("token_count")
  conditionTags  Json?    @map("condition_tags")
  focusAreaTags  Json?    @map("focus_area_tags")
  safetyTags     Json?    @map("safety_tags")
  reviewStatus   String   @default("approved") @map("review_status")
  reviewedBy     String?  @map("reviewed_by")
  reviewNotes    String?  @map("review_notes")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, chunkIndex])
  @@index([reviewStatus])
  @@map("knowledge_chunks")
}

model AssistantPolicy {
  id                  String   @id @default(cuid())
  name                String   @unique
  policyType          String   @map("policy_type")
  content             String
  priority            Int      @default(0)
  appliesToIntentTags Json?    @map("applies_to_intent_tags")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([policyType, active])
  @@map("assistant_policies")
}

model ChildContextSnapshot {
  id                  String   @id @default(cuid())
  childId             String   @map("child_id")
  snapshotType        String   @default("assistant") @map("snapshot_type")
  summary             String
  strengths           Json?
  risks               Json?
  activeFocusAreas    Json?    @map("active_focus_areas")
  latestPatterns      Json?    @map("latest_patterns")
  latestRoadmapTargets Json?   @map("latest_roadmap_targets")
  latestInsightId     String?  @map("latest_insight_id")
  progressCount       Int      @default(0) @map("progress_count")
  roadmapCount        Int      @default(0) @map("roadmap_count")
  progressWindowDays  Int      @default(14) @map("progress_window_days")
  lastProgressAt      DateTime? @map("last_progress_at")
  dataCompleteness    Json?    @map("data_completeness")
  sourceDataHash      String   @map("source_data_hash")
  version             Int      @default(1)
  generatedBy         String?  @map("generated_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, snapshotType, createdAt])
  @@index([childId, sourceDataHash])
  @@map("child_context_snapshots")
}

model AssistantResponseLog {
  id                       String   @id @default(cuid())
  guardianId               String   @map("guardian_id")
  childId                  String?  @map("child_id")
  conversationId           String?  @map("conversation_id")
  question                 String
  intent                   String
  retrievedChildSnapshotIds Json?   @map("retrieved_child_snapshot_ids")
  retrievedProgressEntryIds Json?   @map("retrieved_progress_entry_ids")
  retrievedKnowledgeChunkIds Json?  @map("retrieved_knowledge_chunk_ids")
  retrievedPolicyIds       Json?    @map("retrieved_policy_ids")
  promptVersion            String?  @map("prompt_version")
  modelName                String?  @map("model_name")
  requestPayload           Json?    @map("request_payload")
  responseText             String   @map("response_text")
  responseJson             Json?    @map("response_json")
  safetyOutcome            String?  @map("safety_outcome")
  fallbackUsed             Boolean  @default(false) @map("fallback_used")
  latencyMs                Int?     @map("latency_ms")
  createdAt                DateTime @default(now()) @map("created_at")

  guardian     Guardian               @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  child        Child?                 @relation(fields: [childId], references: [id], onDelete: SetNull)
  conversation AssistantConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  evaluations  AssistantEvaluation[]

  @@index([guardianId, createdAt])
  @@index([childId, createdAt])
  @@index([conversationId, createdAt])
  @@index([intent, createdAt])
  @@map("assistant_response_logs")
}

model AssistantEvaluation {
  id                 String   @id @default(cuid())
  responseLogId      String   @map("response_log_id")
  guardianId         String   @map("guardian_id")
  childId            String?  @map("child_id")
  evaluationVersion  String   @map("evaluation_version")
  relevanceScore     Int      @map("relevance_score")
  safetyScore        Int      @map("safety_score")
  faithfulnessScore  Int      @map("faithfulness_score")
  actionabilityScore Int      @map("actionability_score")
  overallScore       Int      @map("overall_score")
  issues             Json?
  summary            String?
  createdAt          DateTime @default(now()) @map("created_at")

  responseLog AssistantResponseLog @relation(fields: [responseLogId], references: [id], onDelete: Cascade)
  guardian    Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  child       Child?               @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([responseLogId, createdAt])
  @@index([guardianId, createdAt])
  @@index([childId, createdAt])
  @@index([overallScore, createdAt])
  @@map("assistant_evaluations")
}

model Provider {
  id           String   @id @default(cuid())
  name         String
  specialty    String
  address      String?
  phone        String?
  website      String?
  latitude     Float?
  longitude    Float?
  openingHours Json?    @map("opening_hours")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([specialty])
  @@map("providers")
}

model ProcessingJob {
  id           String    @id @default(cuid())
  mediaAssetId String?   @map("media_asset_id")
  kind         String
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  payload      Json?
  result       Json?
  error        String?
  runAfter     DateTime? @map("run_after")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([status, runAfter])
  @@index([mediaAssetId])
  @@map("processing_jobs")
}
